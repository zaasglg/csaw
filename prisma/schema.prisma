// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Volunteer {
  id           String   @id @default(cuid())
  surname      String
  firstName    String
  patronymic   String?
  birthDate    DateTime
  citizenship  String
  country      String
  region       String
  category     String
  infoLanguage String?
  phone        String
  email        String   @unique
  createdAt    DateTime @default(now())
}

model HackathonTeam {
  id          String   @id @default(cuid())
  teamName    String
  country     String
  region      String
  captainName String
  createdAt   DateTime @default(now())
}

model Speaker {
  id           String   @id @default(cuid())
  name         String
  role         String
  organization String
  bio          String?
  avatarUrl    String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
